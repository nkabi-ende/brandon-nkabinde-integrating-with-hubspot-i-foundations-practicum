html
  head
    title= title
    link(rel='stylesheet', href='/css/style.css')
  body
    div.container
      h1 Video Games Collection
      
      p
        a(href='/update-cobj') Add to this table
      
      table(border='1', cellpadding='10', cellspacing='0')
        thead
          tr
            th Name
            th Genre
            th Rating
        tbody
          if customObjects && customObjects.length > 0
            each object in customObjects
              tr
                td= object.properties.name
                td= object.properties.genre || 'N/A'
                td= object.properties.rating || 'N/A'
          else
            tr
              td(colspan='3') No video games found. Add one below!
      
      br
      p
        a(href='/update-cobj') Add another game
